{
  "name": "Anamnese",
  "type": "object",
  "properties": {
    "cliente_id": {
      "type": "string",
      "title": "Cliente"
    },
    "nome": {
      "type": "string",
      "title": "Nome do cliente ou prospecto"
    },
    "whatsapp": {
      "type": "string",
      "title": "WhatsApp"
    },
    "data": {
      "type": "string",
      "format": "date",
      "title": "Data da anamnese"
    },
    "token": {
      "type": "string",
      "title": "Token do link p\u00fablico"
    },
    "status": {
      "type": "string",
      "enum": [
        "pendente",
        "respondida"
      ],
      "default": "pendente",
      "title": "Status"
    },
    "perguntas": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "codigo": {
            "type": "string",
            "title": "C\u00f3digo"
          },
          "categoria": {
            "type": "string",
            "title": "Categoria"
          },
          "pergunta": {
            "type": "string",
            "title": "Pergunta"
          },
          "tipo": {
            "type": "string",
            "title": "Tipo de resposta"
          },
          "opcoes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "title": "Op\u00e7\u00f5es pr\u00e9-definidas"
          },
          "resposta": {
            "type": "string",
            "title": "Resposta"
          }
        },
        "required": [
          "codigo",
          "pergunta"
        ]
      },
      "title": "Perguntas selecionadas"
    },
    "meta_proteica": {
      "type": "object",
      "title": "Meta proteica calculada",
      "properties": {
        "fator": {
          "type": "number",
          "title": "Fator (g/kg)"
        },
        "gramas_dia": {
          "type": "number",
          "title": "Meta di\u00e1ria (g)"
        },
        "refeicao_min": {
          "type": "number",
          "title": "M\u00ednimo por refei\u00e7\u00e3o (g)"
        },
        "refeicao_max": {
          "type": "number",
          "title": "M\u00e1ximo por refei\u00e7\u00e3o (g)"
        },
        "refeicoes": {
          "type": "number",
          "title": "Refei\u00e7\u00f5es sugeridas"
        },
        "peso": {
          "type": "number",
          "title": "Peso (kg)"
        },
        "idade": {
          "type": "number",
          "title": "Idade (anos)"
        },
        "altura": {
          "type": "number",
          "title": "Altura (cm)"
        },
        "sexo": {
          "type": "string",
          "title": "Sexo"
        },
        "nivel_atividade": {
          "type": "string",
          "title": "N\u00edvel de atividade"
        },
        "objetivo": {
          "type": "string",
          "title": "Objetivo"
        },
        "usa_glp1": {
          "type": "boolean",
          "title": "Usa GLP-1"
        },
        "cliente_vinculado": {
          "type": "string",
          "title": "Cliente vinculado"
        },
        "prospecto_criado": {
          "type": "boolean",
          "title": "Criou novo prospecto"
        }
      }
    },
    "respondida_em": {
      "type": "string",
      "format": "date-time",
      "title": "Respondida em"
    }
  },
  "required": [
    "token",
    "perguntas"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}