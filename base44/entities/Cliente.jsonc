{
  "name": "Cliente",
  "type": "object",
  "properties": {
    "nome": {
      "type": "string",
      "title": "Nome completo"
    },
    "codigo": {
      "type": "string",
      "title": "ID interno"
    },
    "email": {
      "type": "string",
      "title": "E-mail"
    },
    "notas": {
      "type": "string",
      "title": "Notas do cliente"
    },
    "whatsapp": {
      "type": "string",
      "title": "WhatsApp"
    },
    "data_nascimento": {
      "type": "string",
      "format": "date",
      "title": "Data de Nascimento"
    },
    "sexo": {
      "type": "string",
      "enum": [
        "Feminino",
        "Masculino"
      ],
      "title": "Sexo"
    },
    "altura": {
      "type": "number",
      "title": "Altura (cm)"
    },
    "grupo": {
      "type": "string",
      "title": "Grupo"
    },
    "coach": {
      "type": "string",
      "title": "Coach respons\u00e1vel"
    },
    "share_token": {
      "type": "string",
      "title": "Token de compartilhamento"
    },
    "status": {
      "type": "string",
      "enum": [
        "prospecto",
        "ativo",
        "pausado",
        "encerrado"
      ],
      "default": "ativo",
      "title": "Status do acompanhamento"
    },
    "objetivo": {
      "type": "string",
      "title": "Objetivo principal"
    },
    "data_inicio": {
      "type": "string",
      "format": "date",
      "title": "In\u00edcio do acompanhamento"
    },
    "proxima_avaliacao": {
      "type": "string",
      "format": "date",
      "title": "Pr\u00f3xima avalia\u00e7\u00e3o"
    },
    "meta_proteica": {
      "type": "object",
      "title": "Meta proteica (\u00faltimo resultado)",
      "properties": {
        "fator": {
          "type": "number",
          "title": "Fator (g/kg)"
        },
        "gramas_dia": {
          "type": "number",
          "title": "Meta di\u00e1ria (g)"
        },
        "refeicao_min": {
          "type": "number",
          "title": "M\u00ednimo por refei\u00e7\u00e3o (g)"
        },
        "refeicao_max": {
          "type": "number",
          "title": "M\u00e1ximo por refei\u00e7\u00e3o (g)"
        },
        "refeicoes": {
          "type": "number",
          "title": "Refei\u00e7\u00f5es sugeridas"
        },
        "peso": {
          "type": "number",
          "title": "Peso (kg)"
        },
        "idade": {
          "type": "number",
          "title": "Idade (anos)"
        },
        "altura": {
          "type": "number",
          "title": "Altura (cm)"
        },
        "sexo": {
          "type": "string",
          "title": "Sexo"
        },
        "nivel_atividade": {
          "type": "string",
          "title": "N\u00edvel de atividade"
        },
        "objetivo": {
          "type": "string",
          "title": "Objetivo"
        },
        "usa_glp1": {
          "type": "boolean",
          "title": "Usa GLP-1"
        },
        "origem": {
          "type": "string",
          "title": "Origem do c\u00e1lculo"
        },
        "calculado_em": {
          "type": "string",
          "format": "date-time",
          "title": "Calculado em"
        }
      }
    }
  },
  "required": [
    "nome"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.coach": "{{user.data.coach_nome}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.coach": "{{user.data.coach_nome}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.coach": "{{user.data.coach_nome}}"
        }
      ]
    }
  }
}