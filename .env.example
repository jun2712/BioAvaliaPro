# Copy this file to .env.local. Integration and deploy credentials have their
# own local templates: .env.integrations.local and .env.deploy.local.

# Frontend (safe to expose; RLS still protects the data)
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<publishable-or-anon-key>

# Server-side scripts only. Never expose this in Vite variables or browser code.
SUPABASE_SERVICE_ROLE_KEY=<service-role-or-secret-key>

# Edge Function secrets. Set these in Supabase with `supabase secrets set`,
# not in Vercel and never with a VITE_ prefix.
# GOOGLE_SERVICE_ACCOUNT_EMAIL=<service-account@project.iam.gserviceaccount.com>
# GOOGLE_PRIVATE_KEY=<private-key-pem>
# GOOGLE_CALENDAR_ID=<shared-calendar-id>
# GEMINI_API_KEY=<gemini-key>
# AI_ENABLED=true
# GROQ_API_KEY=<optional>
# OPENROUTER_API_KEY=<optional>
